<Page x:Class="WCPro.Pages.prod_page"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WCPro.Pages"
        mc:Ignorable="d"
        Title="prod_page"
        Height="1200" 
        Width="1920"
        Background="Transparent">
    <Grid>

        <!-- ===================================== -->
        <!-- GRID DEFINITIONS -->
        <!-- ===================================== -->

        <Grid.RowDefinitions>

            <RowDefinition Height="90"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="60"/>

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="350"/>

        </Grid.ColumnDefinitions>

        <!-- ===================================== -->
        <!-- HEADER -->
        <!-- ===================================== -->

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#1F2937">

            <Grid Margin="20">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <!-- TITLE -->

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="WIRELESS CLIP SYSTEM"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Production Runtime"
                               Foreground="#9CA3AF"
                               FontSize="14"/>

                </StackPanel>

                <!-- BUTTONS -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="LOAD PRODUCT"
                            Width="170"
                            Height="45"
                            Margin="0,0,15,0"
                            Background="#2563EB"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnLoadProduct_Click"/>

                    <Button Content="LOAD SEQUENCE"
                            Width="170"
                            Height="45"
                            Margin="0,0,15,0"
                            Background="#7C3AED"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnLoadSequence_Click"/>
                    
                    <Button Content="← BACK"
                            Width="120"
                            Height="45"
                            Background="#374151"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnBack_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ===================================== -->
        <!-- MAIN VISUAL AREA -->
        <!-- ===================================== -->

        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="20"
                Background="#1F2937"
                CornerRadius="20">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                <!-- IMPORTANT -->
                <!-- SAME COORDINATE SPACE -->

                <Grid x:Name="RuntimeContainer"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">

                    <!-- IMAGE -->

                    <Image x:Name="HarnessImage"
                           Stretch="None"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <!-- RUNTIME CANVAS -->

                    <Canvas x:Name="RuntimeCanvas"
                            Background="Transparent"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"/>

                </Grid>

            </ScrollViewer>

        </Border>

        <!-- ===================================== -->
        <!-- RUNTIME SIDEBAR -->
        <!-- ===================================== -->

        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="0,20,20,20"
                Background="#1F2937"
                CornerRadius="20">

            <Grid Margin="20">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <!-- titulo -->

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="Auto"/>
                    <!-- stats -->

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="Auto"/>
                    <!-- validation -->

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="Auto"/>
                    <!-- manual test -->

                    <RowDefinition Height="20"/>

                    <RowDefinition Height="*"/>
                    <!-- log -->

                </Grid.RowDefinitions>

                <!-- TITLE -->

                <TextBlock Text="RUNTIME MONITOR"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"/>

                <!-- ===================================== -->
                <!-- STATISTICS -->
                <!-- ===================================== -->

                <StackPanel Grid.Row="2">

                    <!-- ACTIVE -->

                    <Border Background="#111827"
                            CornerRadius="12"
                            Padding="15"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <TextBlock Text="ACTIVE NODES"
                                       Foreground="#9CA3AF"
                                       FontSize="13"/>

                            <TextBlock x:Name="TxtActiveNodes"
                                       Text="0"
                                       Foreground="#10B981"
                                       FontSize="28"
                                       FontWeight="Bold"/>

                        </StackPanel>

                    </Border>

                    <!-- ERRORS -->

                    <Border Background="#111827"
                            CornerRadius="12"
                            Padding="15">

                        <StackPanel>

                            <TextBlock Text="ERROR NODES"
                                       Foreground="#9CA3AF"
                                       FontSize="13"/>

                            <TextBlock x:Name="TxtErrorNodes"
                                       Text="0"
                                       Foreground="#EF4444"
                                       FontSize="28"
                                       FontWeight="Bold"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

                <!-- ===================================== -->
                <!-- VALIDATION STATUS -->
                <!-- ===================================== -->

                <Border Background="#111827"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,40,0,10"
                    Grid.Row="4">

                    <StackPanel>

                        <TextBlock Text="CURRENT VALIDATION STEP"
                            Foreground="#9CA3AF"
                            FontSize="13"/>

                        <TextBlock x:Name="TxtValidationStep"
                               Text="WAITING..."
                               Foreground="#FBBF24"
                               FontSize="20"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                        <TextBlock x:Name="TxtSequenceName"
                               Text="No Sequence Loaded"
                               Foreground="#9CA3AF"
                               FontSize="12"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>

                    </StackPanel>
                </Border>

                <!-- ===================================== -->
                <!-- MANUAL TEST PANEL -->
                <!-- ===================================== -->

                <Border Grid.Row="6"
                    Background="#111827"
                    CornerRadius="15"
                    Padding="15"
                    Margin="0,15,0,15">

                    <StackPanel>

                        <TextBlock Text="MANUAL TEST"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                        <WrapPanel>

                            <Button Content="NODE 1"
                                Width="140"
                                Height="40"
                                Margin="5"
                                Click="BtnNode1_Click"/>

                            <Button Content="NODE 2"
                                Width="140"
                                Height="40"
                                Margin="5"
                                Click="BtnNode2_Click"/>

                            <Button Content="NODE 3"
                                Width="140"
                                Height="40"
                                Margin="5"
                                Click="BtnNode3_Click"/>

                            <Button Content="NODE 4"
                                Width="140"
                                Height="40"
                                Margin="5"
                                Click="BtnNode4_Click"/>

                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ===================================== -->
                <!-- MANUAL TEST PANEL -->
                <!-- ===================================== -->


                <!-- ===================================== -->
                <!-- LIVE EVENT LOG -->
                <!-- ===================================== -->

                <Border Grid.Row="8"
                        Background="#111827"
                        CornerRadius="15"
                        Padding="15">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="15"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>

                        <TextBlock Text="LIVE EVENT LOG"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <ListBox x:Name="RuntimeLog"
                                 Grid.Row="2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#D1D5DB"
                                 FontFamily="Consolas"
                                 FontSize="13">

                            <ListBoxItem Content="[SYSTEM] Runtime initialized"/>

                        </ListBox>

                    </Grid>

                </Border>

            </Grid>
        </Border>

        <!-- ===================================== -->
        <!-- FOOTER -->
        <!-- ===================================== -->

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Background="#1F2937">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <!-- STATUS -->

                <TextBlock x:Name="StatusText"
                           Text="SYSTEM READY"
                           Foreground="#10B981"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- VERSION -->

                <TextBlock Grid.Column="1"
                           Text="WCPro Runtime"
                           Foreground="#9CA3AF"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

        <!-- ===================================== -->
        <!-- PASS OVERLAY -->
        <!-- ===================================== -->

        <Grid x:Name="PassOverlay"
                  Visibility="Collapsed"
                  Background="#CC000000"
                  Grid.RowSpan="3"
                  Grid.ColumnSpan="2"
                  Panel.ZIndex="999">

            <Border Width="700"
                    Height="350"
                    Background="#111827"
                    CornerRadius="30"
                    BorderBrush="#10B981"
                    BorderThickness="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                    <!-- CHECK ICON -->

                    <TextBlock Text="✔"
                           Foreground="#10B981"
                           FontSize="90"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                    <!-- PASS -->

                    <TextBlock Text="PASS"
                           Foreground="#10B981"
                           FontSize="72"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>

                    <!-- SUBTITLE -->

                    <TextBlock Text="HARNESS VALIDATED SUCCESSFULLY"
                           Foreground="White"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>
</Page>
