<Page x:Class="WCPro.Pages.settings_page"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WCPro.Pages"
        mc:Ignorable="d"
        Title="settings_page"
        Height="1200" 
        Width="1920"
        Background="Transparent">

    <Border Background="#111827"
            CornerRadius="20"
            Margin="15">

        <Grid>

            <!-- ========================= -->
            <!-- GRID DEFINITIONS -->
            <!-- ========================= -->

            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- ========================= -->
            <!-- HEADER -->
            <!-- ========================= -->

            <Border Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Background="#1F2937"
                    CornerRadius="20,20,0,0">

                <Grid Margin="25,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical"
                                VerticalAlignment="Center">

                        <TextBlock Text="WIRELESS CLIP SYSTEM"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Product Configuration"
                                   Foreground="#9CA3AF"
                                   FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Background="#10B981"
                                Width="14"
                                Height="14"
                                CornerRadius="7"
                                Margin="0,0,10,0"/>

                        <TextBlock Text="CONFIG MODE"
                                   Foreground="White"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,25,0"/>
                        <Button x:Name="BtnBack"
            Content="← BACK"
            Width="120"
            Height="40"
            Background="#374151"
            Foreground="White"
            FontWeight="Bold"
            BorderThickness="0"
            Cursor="Hand"
            Click="BtnBack_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================= -->
            <!-- LEFT PANEL -->
            <!-- ========================= -->

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="#1F2937"
                    Margin="15"
                    CornerRadius="18">

                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="NODE LIST"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"/>

                    <!-- NODES -->

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel x:Name="NodeListPanel">

                            <!-- Dynamic nodes here -->

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>

            <!-- ========================= -->
            <!-- CENTER PANEL -->
            <!-- ========================= -->

            <Border Grid.Row="1"
                    Grid.Column="1"
                    Background="#1F2937"
                    Margin="0,15"
                    CornerRadius="18">

                <Grid Margin="20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TITLE -->

                    <TextBlock Text="PRODUCT CONFIGURATION"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"/>

                    <!-- BUTTONS -->

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal">

                        <Button x:Name="BtnLoadImage"
                                Content="LOAD IMAGE"
                                Width="160"
                                Height="45"
                                Margin="0,0,15,0"
                                Background="#2563EB"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnLoadImage_Click"/>

                        <Button x:Name="BtnSaveProduct"
                                Content="SAVE PRODUCT"
                                Width="160"
                                Height="45"
                                Margin="0,0,15,0"
                                Background="#10B981"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand" Click="BtnSaveProduct_Click"/>

                        <Button x:Name="BtnLoadProduct"
                                Content="LOAD PRODUCT"
                                Width="160"
                                Height="45"
                                Margin="0,0,15,0"
                                Background="#F59E0B"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnLoadProduct_Click"/>

                        <Button x:Name="BtnClear"
                                Content="CLEAR NODES"
                                Width="160"
                                Height="45"
                                Background="#EF4444"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand" Click="BtnClear_Click"/>

                    </StackPanel>

                    <!-- IMAGE + CANVAS -->

                    <Border Grid.Row="4"
                            Background="#111827"
                            CornerRadius="18"
                            ClipToBounds="True"
                            MouseRightButtonDown="Editor_MouseRightButtonDown"
                            MouseRightButtonUp="Editor_MouseRightButtonUp"
                            MouseMove="Editor_MouseMove">

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">

                            <Grid x:Name="EditorContainer"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">

                                <!-- IMAGE -->

                                <Image x:Name="HarnessImage"
                                       Stretch="None"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>

                                <!-- OVERLAY CANVAS -->

                                <Canvas x:Name="NodeCanvas"
                                        Background="Transparent"
                                        MouseLeftButtonDown="NodeCanvas_MouseLeftButtonDown"
                                        MouseWheel="NodeCanvas_MouseWheel"/>

                            </Grid>

                        </ScrollViewer>

                    </Border>

                </Grid>

            </Border>

            <!-- ========================= -->
            <!-- RIGHT PANEL -->
            <!-- ========================= -->

            <Border Grid.Row="1"
                    Grid.Column="2"
                    Background="#1F2937"
                    Margin="15"
                    CornerRadius="18">

                <Grid Margin="20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="NODE INFORMATION"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"/>

                    <!-- NODE DETAILS -->

                    <StackPanel Grid.Row="2">

                        <TextBlock Text="Selected Node"
                                   Foreground="#9CA3AF"
                                   FontSize="14"/>

                        <TextBox x:Name="TxtNodeName"
                                 Height="40"
                                 Margin="0,5,0,15"
                                 Background="#111827"
                                 Foreground="White"
                                 BorderBrush="#374151"
                                 IsReadOnly="True"/>

                        <TextBlock Text="ESP32 MAC Address"
                                   Foreground="#9CA3AF"
                                   FontSize="14"/>

                        <TextBox x:Name="TxtMacAddress"
                                 Height="40"
                                 Margin="0,5,0,15"
                                 Background="#111827"
                                 Foreground="White"
                                 BorderBrush="#374151"/>

                        <TextBlock Text="Node Type"
                                   Foreground="#9CA3AF"
                                   FontSize="14"/>

                        <ComboBox x:Name="CmbNodeType"
                                  Height="40"
                                  Margin="0,5,0,15"
                                  Background="#111827"
                                  Foreground="White"
                                  BorderBrush="#374151">

                            <ComboBoxItem Content="Clip"/>
                            <ComboBoxItem Content="LED"/>
                            <ComboBoxItem Content="Sensor"/>
                            <ComboBoxItem Content="Relay"/>

                        </ComboBox>

                        <Button Content="APPLY CHANGES"
                                Height="50"
                                Background="#2563EB"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand" Click="BtnApplyChanges_Click"/>

                    </StackPanel>

                    <!-- EVENT LOG -->

                    <Border Grid.Row="4"
                            Background="#111827"
                            CornerRadius="15"
                            Padding="15">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="EVENT LOG"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>

                            <ListBox x:Name="EventLogList"
                                     Grid.Row="2"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#D1D5DB"
                                     FontFamily="Consolas"
                                     FontSize="14">

                                <ListBoxItem Content="[SYSTEM] Waiting for image..."/>

                            </ListBox>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

            <!-- ========================= -->
            <!-- FOOTER -->
            <!-- ========================= -->

            <Border Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Background="#1F2937"
                    CornerRadius="0,0,20,20">

                <Grid Margin="20,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="WCPro Wireless Clip Monitoring System"
                               Foreground="#9CA3AF"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="v1.0"
                               Foreground="#9CA3AF"
                               VerticalAlignment="Center"/>

                </Grid>

            </Border>

        </Grid>

    </Border>
</Page>
